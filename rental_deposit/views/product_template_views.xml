<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">rental_deposit.product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="rental_product_base.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="deposit_amount" position="replace">
                <field name="rental_deposit_type"/>
                <field name="rental_deposit_value"/>
                <field name="rental_deposit_mode"/>
            </field>
        </field>
    </record>
</odoo>
