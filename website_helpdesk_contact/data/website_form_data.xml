<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_mgmt.model_helpdesk_ticket" model="ir.model">
        <field name="website_form_key">contact_helpdesk_ticket</field>
        <field name="website_form_default_field_id" ref="helpdesk_mgmt.field_helpdesk_ticket__description"/>
        <field name="website_form_access">True</field>
        <field name="website_form_label">Create Helpdesk Ticket</field>
    </record>

    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>helpdesk.ticket</value>
        <value eval="[
            'name',
            'description',
            'partner_name',
            'partner_email',
            'team_id',
            'category_id',
            'priority',
        ]"/>
    </function>
</odoo>
