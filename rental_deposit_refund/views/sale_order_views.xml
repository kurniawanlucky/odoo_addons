<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">rental_deposit_refund.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_deposit_refund"
                type="object"
                string="Refund Deposit"
                class="oe_highlight"
                invisible="state not in ('sale','done') and deposit_balance_total &lt;= 0.0"/>
            </xpath>
        </field>
    </record>
</odoo>
