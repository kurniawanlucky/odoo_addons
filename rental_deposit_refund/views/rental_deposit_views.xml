<odoo>
    <!-- Action to open rental deposit records -->
    <record id="action_rental_deposit" model="ir.actions.act_window">
        <field name="name">Rental Deposits</field>
        <field name="res_model">rental.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click create to add a new rental deposit.
            </p>
        </field>
    </record>

    <!-- Main menu for Rental Deposits under Rental -->
    <menuitem id="menu_rental_root" name="Rental" sequence="10"/>
    <menuitem id="menu_rental_deposits" name="Deposits" parent="menu_rental_root" sequence="20" action="action_rental_deposit"/>

    <!-- Tree/List View -->
    <record id="view_rental_deposit_tree" model="ir.ui.view">
        <field name="name">rental.deposit.tree</field>
        <field name="model">rental.deposit</field>
        <field name="arch" type="xml">
            <list string="Rental Deposits">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="deposit_invoice_id"/>
                <field name="refund_invoice_id"/>
                <field name="amount_deposit"/>
                <field name="amount_refunded"/>
                <field name="balance"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_rental_deposit_form" model="ir.ui.view">
        <field name="name">rental.deposit.form</field>
        <field name="model">rental.deposit</field>
        <field name="arch" type="xml">
            <form string="Rental Deposit">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="sale_order_id"/>
                    </group>
                    <group>
                        <field name="deposit_invoice_id"/>
                        <field name="refund_invoice_id"/>
                    </group>
                    <group>
                        <field name="amount_deposit"/>
                        <field name="amount_refunded"/>
                        <field name="balance"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
