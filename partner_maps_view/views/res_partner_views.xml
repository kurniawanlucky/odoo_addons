<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_map" model="ir.ui.view">
        <field name="name">res.partner.form.map</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='geo_location']//group[last()]" position="after">
                <group string="Map">
                    <field name="partner_latitude" widget="maps"
                           options="{'lat_field': 'partner_latitude', 'lng_field': 'partner_longitude', 'zoom': 13}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
