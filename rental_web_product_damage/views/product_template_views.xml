<odoo>
    <record id="view_product_template_form_inherit_damage" model="ir.ui.view">
        <field name="name">product.template.form.inherit.damage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="refresh_damage_token"
                        type="object"
                        class="btn btn-secondary"
                        string="Refresh Damage Token"
                        invisible="type != 'rental'"/>
            </header>
            <div name="button_box" position="inside">
                <button name="action_open_damage_page"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        string="Damage Page"
                        invisible="not damage_token"/>
            </div>
        </field>
    </record>
</odoo>
