<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale_line_delivery_address.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='product_type']" position="before">
                <field name="intervention_address_id"
                       options="{'no_create': True}"
                       context="{'default_parent_id': parent.partner_id, 'show_address': False, 'show_vat': False}"
                       readonly="not product_updatable"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="intervention_address_id" optional="show" width="250"/>
            </xpath>
        </field>
    </record>
</odoo>
