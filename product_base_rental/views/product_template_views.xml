<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">sale_start_end_dates.product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="before">
                <group name="product_rental" string="Rental" invisible="type != 'rental'">
                    <field name="rental_price_per_hour" />
                    <field name="rental_price_per_week" />
                    <field name="rental_price_per_day" />
                    <field name="deposit_amount" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
